{
  "name": "@ai-connect/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/devServer.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "smoke:build-control": "tsx src/scripts/buildControlSmoke.ts",
    "smoke:runner": "tsx src/scripts/runnerLiveSmoke.ts",
    "dogfood": "tsx src/scripts/dogfood.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-connect/shared": "workspace:*",
    "@octokit/app": "^16.1.2",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "drizzle-orm": "0.45.2",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "jose": "^6.2.3",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "stripe": "^22.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.0",
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.28.1",
    "pino-pretty": "11.3.0",
    "tsx": "4.19.2",
    "typescript": "5.5.4",
    "vitest": "2.1.8"
  }
}
