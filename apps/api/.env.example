# AI Connect API — local development environment.
#
# Copy to .env.staging.local (preferred) or .env.local and fill in.
# Both are gitignored. NEVER put a production value in these files.
#
#   cp apps/api/.env.example apps/api/.env.staging.local
#
# Loaded by src/lib/loadLocalEnv.ts, which runs only outside production and
# never overrides a variable already exported in your shell.
# See docs/STAGING_DATABASE.md.

# ---------------------------------------------------------------------------
# Database — LOCAL STAGING ONLY
# ---------------------------------------------------------------------------
# This is the connection string for the disposable container defined in
# docker-compose.staging.yml. It is a throwaway local credential, not a secret.
# Never replace it with the production Supabase pooler URL: `pnpm db:migrate`
# refuses non-local hosts, but nothing stops a route from writing to whatever
# this points at.
DATABASE_URL=postgresql://aiconnect:aiconnect_local_dev@127.0.0.1:55432/ai_connect_staging

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Auth0 — optional locally
# ---------------------------------------------------------------------------
# Leave unset to boot without auth (/health and /version still work; every
# /api/* route returns 401 auth0_not_configured).
#
# To exercise authenticated routes locally without the real tenant, use the
# harness in src/scripts/localApiHarness.ts — it starts its own JWKS server and
# sets these two itself for the API process it boots:
#   pnpm --filter @ai-connect/api smoke:build-control
#   pnpm test:integration
# AUTH0_ISSUER_BASE_URL=https://macrotechtitandev.us.auth0.com/
# AUTH0_AUDIENCE=https://api.aiconnect.macrotechtitan.com

# ---------------------------------------------------------------------------
# Optional secrets — leave unset unless the feature you are working on needs
# them. Generate throwaway local values; never copy production ones here.
# ---------------------------------------------------------------------------
# MASTER_KEY=            # 32-byte hex: openssl rand -hex 32
# DIAGNOSTICS_TOKEN=     # >=32 chars:  openssl rand -hex 32
# STRIPE_SECRET_KEY=
# GITHUB_APP_ID=
# CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# Build Control runner — OFF unless BOTH of the first two are set
# ---------------------------------------------------------------------------
# Starting a Build Run then spawns a real Claude Code process on this machine.
# An instance that is not meant to execute anything must never be one flag away
# from doing so, which is why enabling it takes two deliberate variables.
# See docs/BUILD_CONTROL_RUNNER.md.
#
# AICONNECT_RUNNER_ENABLED=1
# AICONNECT_RUNNER_WORKSPACE_ROOT=   # the ONLY tree a worker may execute in
# CLAUDE_CODE_BIN=                   # optional; resolved from PATH otherwise
# AICONNECT_RUNNER_LOG_DIR=          # raw transcripts; defaults under the OS temp dir
# AICONNECT_RUNNER_TIMEOUT_MS=1800000
# AICONNECT_RUNNER_MODEL=
# AICONNECT_RUNNER_WORKSPACES=  # JSON allow-list of selectable repositories:
#   {"devos":{"path":"DevOS","projects":["<project-uuid>"]}}
#   Unset = any git repo directly under the root is selectable by directory name.

# ---------------------------------------------------------------------------
# Independent reviewer (docs/BUILD_CONTROL_REVIEWER.md)
# ---------------------------------------------------------------------------
# The reviewer is a SEPARATE boundary from the worker: a fresh session, no
# access to the worker's conversation, and read-only tools. Provider-neutral.
#
# AICONNECT_REVIEWER_PROVIDER=claude_code
# AICONNECT_REVIEWER_MODEL=
# AICONNECT_REVIEWER_TIMEOUT_MS=600000
# AICONNECT_REVIEWER_CONTEXT_FILES=CLAUDE.md,docs/MTTBuild.md
