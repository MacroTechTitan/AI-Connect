{
  "name": "ai-connect",
  "version": "0.0.0",
  "private": true,
  "description": "The unified orchestration layer for AI-assisted development",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r --parallel dev",
    "db:generate": "pnpm --filter @ai-connect/api db:generate",
    "db:studio": "pnpm --filter @ai-connect/api db:studio"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  }
}
