{
  "name": "ai-connect",
  "version": "0.0.0",
  "private": true,
  "description": "The unified orchestration layer for AI-assisted development",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r --parallel dev",
    "db:generate": "pnpm --filter @ai-connect/api db:generate",
    "db:migrate": "pnpm --filter @ai-connect/api db:migrate",
    "db:studio": "pnpm --filter @ai-connect/api db:studio",
    "staging:db:up": "docker compose -f docker-compose.staging.yml up -d",
    "staging:db:down": "docker compose -f docker-compose.staging.yml down",
    "staging:db:destroy": "docker compose -f docker-compose.staging.yml down -v",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @ai-connect/api test:integration",
    "dogfood": "pnpm --filter @ai-connect/api dogfood --"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  }
}
